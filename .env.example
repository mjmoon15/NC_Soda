# ─────────────────────────────────────────────────────────────
# New Creation Soda — environment configuration
#
# The app runs in DEMO MODE with seed data when these are unset,
# so you can `npm run dev` immediately. Fill these in to connect a
# real Supabase project (see SETUP_CHECKLIST.md).
# ─────────────────────────────────────────────────────────────

# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key (NEVER expose to the browser).
# Used for admin writes and minting signed URLs for gated video/assets.
SUPABASE_SERVICE_ROLE_KEY=
